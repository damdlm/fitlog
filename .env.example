# ============================================================
# FITLOG — Exemplo de variáveis de ambiente
# ============================================================
# 1. Copie este arquivo: cp .env.example .env
# 2. Preencha os valores abaixo com suas configurações reais
# 3. NUNCA commite o .env — ele já está no .gitignore
# ============================================================

# Banco de dados PostgreSQL
DATABASE_URL=postgresql://usuario:senha@localhost:5432/fitlog_db

# Redis — cache distribuído (Flask-Caching) e backend do rate limiter.
# Obrigatório em produção (o app recusa subir sem isso — ver
# config.py:get_config()). Em desenvolvimento/testes não precisa: cai
# automaticamente para SimpleCache (cache em memória do processo, sem
# Redis nenhum), então só preencha isto se quiser testar o comportamento
# real do Redis localmente.
REDIS_URL=

# Chaves de segurança — gere valores únicos com:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
SECURITY_PASSWORD_SALT=

# Senha do usuário admin criado no primeiro boot
# Use uma senha forte com letras, números e caracteres especiais
ADMIN_PASSWORD=

# Domínio oficial da aplicação (ex: https://fitlog.seudominio.com, sem
# barra no final). Usado para montar links absolutos enviados por
# e-mail (hoje só o de reset de senha), em vez de confiar no header
# Host da requisição recebida -- um Host forjado poderia fazer o link
# apontar pro domínio de um atacante (Host Header Injection). Deixe em
# branco só em desenvolvimento local; em produção, configure.
APP_BASE_URL=

# Ambiente da aplicação
# development -> DEBUG ativo, logs verbosos
# production  -> DEBUG desativado, cookies seguros (config.py força isso
#                automaticamente quando DATABASE_URL aponta pra Postgres)
# ATENÇÃO: FLASK_ENV=development e FLASK_DEBUG=True são só para uso local.
# Nunca defina essas duas variáveis em produção — em produção configure
# FLASK_ENV=production (ou nem defina FLASK_DEBUG).
FLASK_ENV=development
FLASK_DEBUG=True
LOG_LEVEL=INFO

# E-mail (Resend) — usado para enviar o e-mail de recuperação de senha.
# Enviado via API HTTPS (não SMTP), pois a Railway bloqueia portas SMTP
# de saída por padrão. Crie uma conta gratuita em https://resend.com
# e gere a API key em API Keys.
# O MAIL_DEFAULT_SENDER precisa ser um endereço de um domínio verificado
# em resend.com -> Domains, OU o remetente de teste onboarding@resend.dev
# (sem verificação, mas só entrega para o próprio e-mail cadastrado na
# conta Resend).
# Se RESEND_API_KEY ficar vazia, o link de reset é apenas escrito no
# log da aplicação em vez de enviado por e-mail (útil em dev local).
RESEND_API_KEY=
MAIL_DEFAULT_SENDER=onboarding@resend.dev

# FitBot — assistente virtual de treino (chat com IA)
# Gemini: crie a chave grátis em https://aistudio.google.com/apikey
# Groq:   crie a chave grátis em https://console.groq.com/keys
# Se ficarem vazias, o botão de chat aparece mas o FitBot responde
# com uma mensagem avisando que o assistente está indisponível.
#
# GEMINI_MODEL: gemini-1.5-flash e gemini-2.5-flash-lite foram
# descontinuados/fechados para novos projetos. gemini-3.5-flash-lite é o
# modelo estável mais barato/rápido da geração atual que ainda processa
# imagem. Se já tiver GEMINI_MODEL configurada no Railway apontando pro
# modelo antigo, atualize-a também por lá.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Cobrança/assinaturas (Asaas) — ver services/billing_service.py.
# Crie a conta em https://www.asaas.com e gere a API key em
# Integrações > API. Use a chave de sandbox enquanto ASAAS_ENV=sandbox.
# ASAAS_API_KEY nunca é exposta ao navegador — só o backend fala com a
# API do Asaas; o dado de cartão do usuário vai direto pro checkout
# hospedado do Asaas, nunca passa pelo nosso servidor.
# ASAAS_WEBHOOK_TOKEN é o token que você mesmo define no painel do
# Asaas em Integrações > Webhooks — usado para validar que um POST em
# /billing/webhook/asaas realmente veio do Asaas.
# Se ficarem vazias, o webhook rejeita tudo (401) e a criação de
# checkout falha explicitamente — não existe modo "sem cobrança"
# silencioso aqui, ao contrário do FitBot acima.
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
ASAAS_ENV=sandbox
