[run]
# Caminhos relativos: permite juntar (coverage combine) os dados gerados em
# jobs/máquinas diferentes do CI.
relative_files = True
# Mede tambem os ramos (if/else nao executados), nao so as linhas.
branch = True
omit =
    tests/*
    migrations/*
    venv/*
    .venv/*
    */__pycache__/*

[report]
# Ordena os arquivos com menor cobertura primeiro, pra facilitar achar
# o que priorizar ao escrever novos testes.
sort = Cover
skip_covered = False
